FROM python:3.11-slim
WORKDIR /app
COPY services/api/requirements.lock.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY services/api/app ./app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GUIDEJUNG_ROOT=/app
RUN useradd --uid 10001 --create-home platform && mkdir -p /app/runtime && chown platform /app/runtime
USER platform
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8100","--no-access-log"]
