# 신규 플랫폼 전용 설정. 기존 guidejung.com 환경변수를 복사하지 않습니다.
APP_ENV=development
DATABASE_URL=sqlite:///runtime/guidejung.db
DATA_MODE=demo
ADMIN_TOKEN=
TOURAPI_SERVICE_KEY=
TOURAPI_DAILY_LIMIT=1000
INTERNAL_API_URL=http://127.0.0.1:8100
HOME_PUBLIC_URL=http://localhost:3100
TRIP_PUBLIC_URL=http://localhost:3101
SEO_ENABLED=false
# production은 DATA_MODE=live, 별도 신규 PostgreSQL URL, 강한 ADMIN_TOKEN 필수
