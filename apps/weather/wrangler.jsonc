// Cloudflare Worker for weather.guidejung.com (separate from the trip Worker in the repo root).
// Run from the repo root: npx wrangler deploy -c apps/weather/wrangler.jsonc (builds with npm run build:weather).
// Static pages: ./out. /api/*: worker/index.ts. Secret: DATA_GO_KR_KEY (Cloudflare 대시보드 또는 wrangler secret put).
{
  "name": "guidejung-weather",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:weather" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 5분마다 특보·미세먼지와 시군구 32곳을 미리 받아 KV guidejung-cache(전 세계 공용, traffic과 같은 KV)에 저장.
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "CACHE", "id": "78659f07655e4ab99683b85951a377e3" }],
  "observability": { "enabled": true }
}
