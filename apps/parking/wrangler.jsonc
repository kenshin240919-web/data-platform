// Cloudflare Worker for parking.guidejung.com (내근처 주차장), separate from the other sites.
// Run from the repo root: npx wrangler deploy -c apps/parking/wrangler.jsonc (builds with npm run build:parking).
// Static pages: ./out. Worker: /api/*, 주차장 상세 /parking/{관리번호}. The lot list ships with the Worker (data/parkings.json).
{
  "name": "guidejung-parking",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:parking" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/parking/*"]
  },
  // The lot list is imported as text and parsed on first use (a large object literal slows the Worker start).
  "rules": [{ "type": "Text", "globs": ["**/data/parkings.json"], "fallthrough": true }],
  "observability": { "enabled": true },
  // 10/23 사용자 승인: parking.guidejung.com 연결(wrangler가 DNS 기록을 만듦).
  "routes": [{ "pattern": "parking.guidejung.com", "custom_domain": true }]
}
