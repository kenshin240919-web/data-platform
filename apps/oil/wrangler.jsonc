// Cloudflare Worker for oil.guidejung.com (내근처 주유소), separate from the other sites.
// Run from the repo root: npx wrangler deploy -c apps/oil/wrangler.jsonc (builds with npm run build:oil).
// Static pages: ./out. Worker: /api/*. The price file ships with the Worker (data/oil.json).
// Deployed by GitHub Actions (oil-deploy.yml), domain oil.guidejung.com (custom domain, 10/21 사용자 승인).
{
  "name": "guidejung-oil",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:oil" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/data/oil.json"], "fallthrough": true }],
  "routes": [{ "pattern": "oil.guidejung.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
