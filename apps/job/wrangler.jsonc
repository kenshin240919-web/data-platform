// Cloudflare Worker for job.guidejung.com (내근처 일자리 — 채용 공고 없이 '일자리 찾을 때 가는 곳'), separate from the other sites.
// Run from the repo root: npx wrangler deploy -c apps/job/wrangler.jsonc (builds with npm run build:job).
// Static pages: ./out. Worker: /api/*, 상세 /place/{id}, sitemap index. The list ships with the Worker (data/places.json). Secrets 없음.
{
  "name": "guidejung-job",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:job" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/place/*", "/sitemap.xml", "/sitemap-places-*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/data/places.json"], "fallthrough": true }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "job.guidejung.com", "custom_domain": true }]
}
