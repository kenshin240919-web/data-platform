// Cloudflare Worker for near.guidejung.com (내근처 — 내 주변 한눈에), separate from the other sites.
// Run from the repo root: npx wrangler deploy -c apps/near/wrangler.jsonc (builds with npm run build:near).
// Static pages: ./out. Worker: /api/where only (live numbers come from the sister sites' own APIs).
{
  "name": "guidejung-near",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:near" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "near.guidejung.com", "custom_domain": true }],
  // 내근처 알림(웹 푸시): 구독·VAPID 키는 공용 KV, 날씨·약국·혜택 데이터는 서비스 바인딩, 발송은 Cron(UTC 22:00 = 한국 07:00, 23:30 = 08:30).
  "kv_namespaces": [{ "binding": "CACHE", "id": "78659f07655e4ab99683b85951a377e3" }],
  "services": [{ "binding": "WEATHER", "service": "guidejung-weather" }, { "binding": "PHARMACY", "service": "guidejung-pharmacy" }, { "binding": "BENEFIT", "service": "guidejung-benefit" }],
  "triggers": { "crons": ["0 22 * * *", "30 23 * * *"] },
  "observability": { "enabled": true }
}
