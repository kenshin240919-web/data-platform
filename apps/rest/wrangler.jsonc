// Cloudflare Worker for rest.guidejung.com (내근처 휴식), separate from the other sites.
// Run from the repo root: npx wrangler deploy -c apps/rest/wrangler.jsonc (builds with npm run build:rest).
// Static pages: ./out. Worker: /api/*, 상세 /shop/{id}, sitemap index. The list ships with the Worker (data/places.json).
{
  "name": "guidejung-rest",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:rest" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/shop/*", "/sitemap.xml", "/sitemap-shops-*"]
  },
  // The list is imported as text and parsed on first use (a large object literal slows the Worker start).
  "rules": [{ "type": "Text", "globs": ["**/data/places.json"], "fallthrough": true }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "rest.guidejung.com", "custom_domain": true }]
}
