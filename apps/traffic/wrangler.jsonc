// Cloudflare Worker for traffic.guidejung.com (separate from trip, weather and charge).
// Run from the repo root: npx wrangler deploy -c apps/traffic/wrangler.jsonc (builds with npm run build:traffic).
// Static pages: ./out. /api/*: worker/index.ts. Secret: EX_API_KEY (한국도로공사 고속도로 공공데이터 포털 인증키).
{
  "name": "guidejung-traffic",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:traffic" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
