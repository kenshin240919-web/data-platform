// Cloudflare Worker for stock.guidejung.com (내근처 재고), separate from the other sites.
// Run from the repo root: npx wrangler deploy -c apps/stock/wrangler.jsonc (builds with npm run build:stock).
// Static pages: ./out (items, areas). Worker: /api/* only. No secrets.
{
  "name": "guidejung-stock",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build:stock" },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "stock.guidejung.com", "custom_domain": true }]
}
